# Copia este archivo a .env.local y completa con los valores de tu proyecto
# de Supabase (Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# NUNCA exponer al cliente. Solo se usa en Route Handlers / Server Actions
# del servidor (app/api/admin/create-user, lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta
